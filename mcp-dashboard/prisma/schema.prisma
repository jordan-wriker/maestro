generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model TaskLog {
  id        Int      @id @default(autoincrement())
  agent     String
  prompt    String
  status    String
  duration  Int
  sessionId String
  createdAt DateTime @default(now())
}
